# ==============================================================================
# DriveGuard — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the repository root for local development.
# For frontend-specific settings, see `frontend/.env.example`.

# ------------------------------------------------------------------------------
# 1. FastAPI AI Inference Engine & Server Binding
# ------------------------------------------------------------------------------
HOST="0.0.0.0"
PORT="8000"
DEBUG="false"
PYTHONPATH="."

# Shared Cryptographic Authentication Token Secret
AUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"
AUTH_TOKEN_ISSUER="driveguard-frontend"
AUTH_TOKEN_AUDIENCE="driveguard-backend"

# ------------------------------------------------------------------------------
# 2. LiveKit Cloud WebRTC Media Transport
# ------------------------------------------------------------------------------
# Get your credentials at https://cloud.livekit.io
LIVEKIT_URL="wss://driveguard-xxxx.livekit.cloud"
LIVEKIT_API_KEY="APICxxxxxxxxxxxxx"
LIVEKIT_API_SECRET="your_livekit_api_secret_key_here"

# ------------------------------------------------------------------------------
# 3. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web origins
CORS_ORIGINS="https://drive-guard-mu.vercel.app,http://localhost:3000,http://127.0.0.1:3000"

# ------------------------------------------------------------------------------
# 4. Next.js Web Cockpit & Gateway (Full-Stack Orchestration)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_FASTAPI_URL="http://localhost:8000"
NEXT_PUBLIC_LIVEKIT_URL="wss://driveguard-xxxx.livekit.cloud"

# Better Auth Secret (Generate via `openssl rand -base64 32`)
BETTER_AUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. Database (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/driveguard?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/driveguard?sslmode=require"
