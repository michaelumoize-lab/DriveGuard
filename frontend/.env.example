# ==============================================================================
# DriveGuard — Frontend & Web Cockpit Environment Variables
# ==============================================================================
# Copy this file to `frontend/.env` or `frontend/.env.local`

# ------------------------------------------------------------------------------
# 1. Database (Neon Serverless PostgreSQL via Prisma ORM)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/driveguard?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/driveguard?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Application & Better Auth
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"

# Optional: OAuth Provider Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 3. AI Inference Microservice & LiveKit Transport
# ------------------------------------------------------------------------------
# URL of the FastAPI AI Engine (local or Render cloud instance)
FASTAPI_URL="http://localhost:8000"
NEXT_PUBLIC_FASTAPI_URL="http://localhost:8000"

# LiveKit Cloud WebRTC endpoint (wss://...)
NEXT_PUBLIC_LIVEKIT_URL="wss://driveguard-xxxx.livekit.cloud"
LIVEKIT_URL="wss://driveguard-xxxx.livekit.cloud"
LIVEKIT_API_KEY="APICxxxxxxxxxxxxx"
LIVEKIT_API_SECRET="your_livekit_api_secret_key_here"
